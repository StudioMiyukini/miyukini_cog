        B4 -- "Compromis" --> B6["recovery gouverné"]
    end
    subgraph INST["Installation d'un service"]
        I1["paquet msp:sha256 signé"] --> I2["contrat + traité + classe H"] --> I3["StrongFather valide"] --> I4["arrêté : Franche, voies, Douane"] --> I5["exposition désactivée par défaut"]
    end
    subgraph MEM["Mémoire MAIA"]
        M1["notes candidates (S1)"] --> M2["validation utilisateur"] --> M3["versionnage"] --> M4["sommeil : consolidation"] --> M5["oubli à la demande"]
    end
    subgraph FEDE["Vie fédérale"]
        F1["candidat + hashcash"] --> F2["invité ≥2"] --> F3["membre ≥4 · 7 j"]
        F3 -- "preuves + quorum 6" --> F4["blacklisté : identité révoquée"]
        F4 -- "nouvelle racine" --> F1
    end
