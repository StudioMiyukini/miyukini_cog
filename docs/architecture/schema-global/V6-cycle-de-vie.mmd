flowchart LR
    subgraph BOOT["Démarrage"]
        B1["Kernel"] --> B2["MiyukiniAdmin détecte"] --> B3["EIP"] --> B4{"Vierge ?<br/>Initialisé ?<br/>Compromis ?"}
