%% @id arch.cog.schema-conceptuel
%% @role architecture-diagram
%% @layer 3-8+kernel
%% @human Schéma conceptuel COG v2 : BorderGuard, zone Franche, Portail interne, zone COG, canal officiel
%% @do visualize_cog_architecture
%% Référence : docs/architecture/MODELE-ZONES-ET-COUCHES-COG.md (2026-10-24)
flowchart TB
    FED(("🤝 Fédération"))
    ORIGIN(("🏛️ Origin"))
    INTL(("🌐 International<br/>(Internet)"))

    FED <-- "identification<br/>certification globale" --> ORIGIN

    subgraph COG["COG"]
        BG{{"🛂 BorderGuard<br/>(pare-feu externe)"}}
        subgraph FRANCHE["🏪 Zone Franche (DMZ)"]
            F1["Services exposables : pages web, services web<br/>DB secondaire · agents relais des services internes<br/>(bureautique coopérative, explorateur web…)"]
        end
        PORTAIL{{"🚪 Portail interne<br/>(pare-feu interne)"}}
        subgraph NAT["🏛️ Zone COG (nationale)"]
            N1["Kernel · Cores · Services · interfaces<br/>stockage local · DB principale"]
        end
    end

    FED -- "identification<br/>certification fédérale" --> BG
    ORIGIN -- "identification<br/>certification globale" --> BG
    INTL -- "zero trust<br/>liste blanche" --> BG
    BG <--> FRANCHE
    FRANCHE <--> PORTAIL
    PORTAIL <--> NAT
    BG -. "canal officiel (tiré, signé Origin)<br/>gouvernance Cores · services officiels<br/>Market officiel · MAJ Cores" .-> NAT

    classDef ext fill:#eef2ff,stroke:#6366f1
    classDef fw fill:#fee2e2,stroke:#dc2626
    classDef franche fill:#fef3c7,stroke:#d97706
    classDef nat fill:#ecfdf5,stroke:#059669
    class FED,ORIGIN,INTL ext
    class BG,PORTAIL fw
    class F1 franche
    class N1 nat
