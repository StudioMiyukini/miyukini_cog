		ct mark 0x00000002 ct direction original limit rate over 640 kbytes/second burst 6843 bytes update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|DEBIT|" group 101
		ct mark 0x00000002 ct direction original limit rate over 640 kbytes/second burst 6843 bytes counter name "rejets" drop
		ct mark 0x00000002 ct direction reply limit rate over 640 kbytes/second burst 6843 bytes update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|DEBIT|" group 101
		ct mark 0x00000002 ct direction reply limit rate over 640 kbytes/second burst 6843 bytes update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|DEBIT|" group 101
		ct mark 0x00000002 ct direction reply limit rate over 640 kbytes/second burst 6843 bytes counter name "rejets" drop
		meta mark set ct mark
		ct state established,related counter accept
		ip saddr 10.77.0.0/24 update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|SORTIE-COG|" group 101
		ip saddr 10.77.0.0/24 counter name "rejets" drop
		ip daddr 10.77.0.0/24 update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|ENTREE-COG|" group 101
