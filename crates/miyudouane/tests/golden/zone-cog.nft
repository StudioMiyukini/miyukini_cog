#!/usr/sbin/nft -f
# Généré par miyudouane — ne pas modifier à la main.
# Douane — pont de zone filtré (segmentation par service, refus par défaut)
# zone=cog reseau=10.77.0.0/24
# journal : nflog groupe 110, prefixe "MDOU|zone-cog|<chaine>|<MOTIF>|"
# prerequis : module nf_conntrack_bridge
flush ruleset

table bridge miyudouane_zone {
	set journal_v4 {
		type ipv4_addr . ipv4_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	set journal_v6 {
		type ipv6_addr . ipv6_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	limit journal {
		rate 50/second burst 100 packets
	}
	counter rejets {
	}
	chain transit {
		type filter hook forward priority filter; policy drop;
		ether type arp accept
		ct state invalid update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|INVALIDE|" group 110
		ct state invalid update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|INVALIDE|" group 110
		ct state invalid counter name "rejets" drop
		ct state established,related counter accept
		iifname "sv5" oifname "z-pi" ip saddr 10.77.0.12 ip daddr 10.77.0.253 tcp dport 7080 meta length <= 1400 ct state new counter accept comment "voie=site service=site flux=0"
		iifname "sv0" oifname "z-pi" ip saddr 10.77.0.10 ip daddr 10.77.0.253 tcp dport 7443 meta length <= 1400 ct state new counter accept comment "voie=jayoffice service=jayoffice flux=1"
		iifname "sv3" oifname "z-pl" ip saddr 10.77.0.11 ip daddr 10.77.0.252 tcp dport 1883 meta length <= 1400 ct state new counter accept comment "voie=alicia service=alicia flux=0"
		iifname "sv*" oifname "sv*" update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|LATERAL|" group 110
		iifname "sv*" oifname "sv*" update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|LATERAL|" group 110
		iifname "sv*" oifname "sv*" counter name "rejets" drop
		ip saddr 10.77.0.0/24 update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|SORTIE-COG|" group 110
		ip saddr 10.77.0.0/24 counter name "rejets" drop
		update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|NON-DECLARE|" group 110
		update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|NON-DECLARE|" group 110
		counter name "rejets" drop
	}
}

table inet miyudouane_zone {
	set journal_v4 {
		type ipv4_addr . ipv4_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	set journal_v6 {
		type ipv6_addr . ipv6_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	limit journal {
		rate 50/second burst 100 packets
	}
	counter rejets {
	}
	chain entree {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|entree|NON-DECLARE|" group 110
		update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|entree|NON-DECLARE|" group 110
		counter name "rejets" drop
	}
	chain transit {
		type filter hook forward priority filter; policy drop;
		update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|NON-DECLARE|" group 110
		update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|transit|NON-DECLARE|" group 110
		counter name "rejets" drop
	}
	chain sortie {
		type filter hook output priority filter; policy drop;
		oif "lo" accept
		update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|sortie|SORTIE-COG|" group 110
		update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|sortie|SORTIE-COG|" group 110
		counter name "rejets" drop
	}
}
