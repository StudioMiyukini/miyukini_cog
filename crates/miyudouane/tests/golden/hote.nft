#!/usr/sbin/nft -f
# Généré par miyudouane hote — ne pas modifier à la main.
# Douane — zone COG sur l'hôte : comptes COG sans sortie, hors flux de boucle
# déclarés par compte (127.0.0.1 / ::1) ; ports COG joignables par la seule
# boucle locale (IPv4 et IPv6). Aucune résolution DNS.
# Table propre : remplacée seule (add + delete + table, une transaction) ;
# aucune autre table touchée.
# journal : nflog groupe 110, prefixe "MDOU|zone-cog|<chaine>|<MOTIF>|"
# arrete portail-interne n°1 empreinte=<sha256>
add table inet miyudouane_hote
delete table inet miyudouane_hote

table inet miyudouane_hote {
	set journal_v4 {
		type ipv4_addr . ipv4_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	set journal_v6 {
		type ipv6_addr . ipv6_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	limit journal {
		rate 50/second burst 100 packets
	}
	counter rejets {
	}
	set comptes_cog {
		type uid
		elements = { "miyukini-kindmother", "miyukini-maia", "miyukini-miyucloud", "miyukini-portail" }
	}

	chain sortie {
		type filter hook output priority filter; policy accept;
		meta skuid != @comptes_cog oifname "lo" accept
		meta skuid @comptes_cog oifname "lo" ct state established,related accept
		meta skuid "miyukini-maia" oifname "lo" ip daddr 127.0.0.1 tcp dport 50051 accept
		meta skuid "miyukini-miyucloud" oifname "lo" ip daddr 127.0.0.1 tcp dport 5432 accept
		meta skuid @comptes_cog ip daddr 10.77.0.253 tcp dport 7080 counter accept comment "voie=site service=site flux=0"
		meta skuid @comptes_cog update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|sortie|SORTIE-COG|" group 110
		meta skuid @comptes_cog update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|sortie|SORTIE-COG|" group 110
		meta skuid @comptes_cog counter name "rejets" drop
	}

	chain entree {
		type filter hook input priority filter; policy accept;
		iifname "lo" accept
		meta l4proto tcp th dport { 5432, 8086, 8090, 11435, 50051 } update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|entree|NON-DECLARE|" group 110
		meta l4proto tcp th dport { 5432, 8086, 8090, 11435, 50051 } update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|zone-cog|entree|NON-DECLARE|" group 110
		meta l4proto tcp th dport { 5432, 8086, 8090, 11435, 50051 } counter name "rejets" drop
	}
}
