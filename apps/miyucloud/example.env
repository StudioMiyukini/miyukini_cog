# =============================================================================
# Miyukini Cloud Environment Configuration
# =============================================================================
# Copy this file to .env and modify as needed for your deployment.
#   cp example.env .env
#
# All variables have sensible defaults. Only override what you need.
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# Root directory for file storage (default: ./storage)
MIYUCLOUD_STORAGE_PATH=./storage

# Path to static files directory (default: ./static)
MIYUCLOUD_STATIC_PATH=./static

# Server port (default: 8086)
MIYUCLOUD_SERVER_PORT=8086

# Server bind address (default: 127.0.0.1)
# Use 0.0.0.0 to bind to all interfaces in Docker
MIYUCLOUD_SERVER_HOST=127.0.0.1

# Public base URL for generating share links and external URLs
# If not set, defaults to http://{MIYUCLOUD_SERVER_HOST}:{MIYUCLOUD_SERVER_PORT}
# Authentication fails if this is not set and you access the host remotely via a domain
# Example: https://cloud.example.com
#MIYUCLOUD_BASE_URL=https://cloud.example.com

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For Docker: use 'postgres' as the hostname (the docker-compose service name)
# For local development: use 'localhost:5432'
MIYUCLOUD_DB_CONNECTION_STRING=postgres://postgres:postgres@postgres/miyucloud

# Maximum number of database connections in the pool (default: 20)
#MIYUCLOUD_DB_MAX_CONNECTIONS=20

# Minimum number of database connections to maintain (default: 5)
#MIYUCLOUD_DB_MIN_CONNECTIONS=5

# Maximum connections for the maintenance pool (background/batch tasks).
# This pool is isolated from user requests, preventing background operations
# (verify_integrity, garbage_collect, storage recalculation) from starving
# interactive traffic. Default: 5
#MIYUCLOUD_DB_MAINTENANCE_MAX_CONNECTIONS=5

# Minimum connections for the maintenance pool. Default: 1
#MIYUCLOUD_DB_MAINTENANCE_MIN_CONNECTIONS=1

# Build-time database URL for SQLx compile-time checks
# Only needed during compilation, not at runtime
DATABASE_URL=postgres://postgres:postgres@localhost:5432/miyucloud

# -----------------------------------------------------------------------------
# AUTHENTICATION CONFIGURATION
# -----------------------------------------------------------------------------

# Lot 2 : aucun secret partagé. Les sessions du navigateur sont des
# identifiants aléatoires opaques conservés côté serveur (cookie
# __Host-miyucloud_session, Secure, HttpOnly, SameSite=Strict), révocables.
# MIYUCLOUD_JWT_SECRET, MIYUCLOUD_JWT_SECRET_PREVIOUS et MIYUCLOUD_WOPI_SECRET
# sont obsolètes et ignorés ; <STORAGE_PATH>/.jwt_secret peut être supprimé.

# Cookies Secure (défaut). `false` seulement pour un développement en HTTP
# hors localhost : les cookies perdent alors Secure et le préfixe __Host-.
#MIYUCLOUD_COOKIE_SECURE=true

# Clients natifs : visa + preuve de possession (Authorization: MiyuVisa …).
# Ancre du COG d'origine : cog_id et clé publique d'émission épinglée
# (64 hex ou base64 URL). Les deux ensemble ; absents = MiyuVisa désactivé.
#MIYUCLOUD_MIYU_COG_ID=
#MIYUCLOUD_MIYU_CLE_EMISSION=
# Ou mode chaîné strict (A-024, A-029) : racine du COG et délégations 0x45
# (base64 URL séparées par « . ») ; délégations aussi acceptées par requête
# dans X-Miyu-Delegations.
#MIYUCLOUD_MIYU_RACINE=
#MIYUCLOUD_MIYU_DELEGATIONS=
# Révocations (lot 2 §8.2, A-007) : registre vérifié du COG d'origine.
# Les trois ensemble (et seulement avec l'ancre ci-dessus). Ancre sans
# révocations = tout visa refusé (fail-closed) ; liste > 15 min = refus.
# Dépôt : tete.sceau + entrees.mrgj déposés par la zone COG, lus seulement.
#MIYUCLOUD_MIYU_REGISTRE=
#MIYUCLOUD_MIYU_CLE_JOURNAL=
#MIYUCLOUD_MIYU_REVOCATIONS_DEPOT=
# Défis de possession et nonces anti-rejeu persistants (A-029, I6) : un
# fichier par élément, dossier 0700 (refus s'il est ouvert aux autres) ; à
# partager entre instances. Défaut : <STORAGE_PATH>/.miyauth-etat.
#MIYUCLOUD_MIYU_ETAT_DIR=

# Reclassement CDR des fichiers hérités « inconnu » (jamais servis dans cet
# état). 0 = tâche désactivée (les fichiers inconnus restent non servis).
#MIYUCLOUD_CDR_RECLASSEMENT=1

# Access (session) lifetime in seconds (default: 3600 = 1 hour)
#MIYUCLOUD_ACCESS_TOKEN_EXPIRY_SECS=3600

# Refresh token lifetime in seconds (default: 2592000 = 30 days)
#MIYUCLOUD_REFRESH_TOKEN_EXPIRY_SECS=2592000

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------

# Enable/disable authentication system (default: true)
#MIYUCLOUD_ENABLE_AUTH=true

# Enable per-user storage quotas (default: false)
#MIYUCLOUD_ENABLE_USER_STORAGE_QUOTAS=false

# Enable file/folder sharing (default: true)
#MIYUCLOUD_ENABLE_FILE_SHARING=true

# Enable trash/recycle bin functionality (default: true)
#MIYUCLOUD_ENABLE_TRASH=true

# Enable search functionality (default: true)
#MIYUCLOUD_ENABLE_SEARCH=true

# -----------------------------------------------------------------------------
# OPENID CONNECT (OIDC) / SSO CONFIGURATION
# -----------------------------------------------------------------------------

# Enable OIDC authentication (default: false)
MIYUCLOUD_OIDC_ENABLED=false

# OIDC provider issuer URL (required if OIDC enabled)
# Example: https://auth.example.com/application/o/miyucloud/
#MIYUCLOUD_OIDC_ISSUER_URL=

# OIDC client ID (required if OIDC enabled)
#MIYUCLOUD_OIDC_CLIENT_ID=

# OIDC client secret (required if OIDC enabled)
#MIYUCLOUD_OIDC_CLIENT_SECRET=

# Callback URL after OIDC authentication (must match IdP config)
# Default: http://localhost:8086/api/auth/oidc/callback
#MIYUCLOUD_OIDC_REDIRECT_URI=http://localhost:8086/api/auth/oidc/callback

# OIDC scopes to request (default: openid profile email)
#MIYUCLOUD_OIDC_SCOPES=openid profile email

# Frontend URL to redirect after successful OIDC login
# Default: http://localhost:8086
#MIYUCLOUD_OIDC_FRONTEND_URL=http://localhost:8086

# Auto-create users on first OIDC login (JIT provisioning) (default: true)
#MIYUCLOUD_OIDC_AUTO_PROVISION=true

# Comma-separated list of OIDC groups that grant admin role
# Example: admins,cloud-admins
#MIYUCLOUD_OIDC_ADMIN_GROUPS=

# Disable password-based login entirely when OIDC is active (default: false)
#MIYUCLOUD_OIDC_DISABLE_PASSWORD_LOGIN=false

# Display name for the OIDC provider shown in UI (default: SSO)
#MIYUCLOUD_OIDC_PROVIDER_NAME=SSO

# -----------------------------------------------------------------------------
# WOPI (WEB APPLICATION OPEN PLATFORM INTERFACE) CONFIGURATION
# -----------------------------------------------------------------------------

# Enable WOPI integration for office document editing (default: false)
# Used with Collabora, OnlyOffice, or other WOPI-compatible editors
MIYUCLOUD_WOPI_ENABLED=false

# URL to the WOPI client's discovery endpoint
# Example for Collabora: http://collabora:9980/hosting/discovery
# Example for OnlyOffice: http://onlyoffice/hosting/discovery
#MIYUCLOUD_WOPI_DISCOVERY_URL=

# Les jetons WOPI sont signés par une clé aléatoire propre au processus
# (jamais configurée) et liés au fichier et à l'utilisateur.
# Durée de vie en secondes (défaut et maximum : 900 = 15 min ; minimum 60)
#MIYUCLOUD_WOPI_TOKEN_TTL_SECS=900

# WOPI lock expiration in seconds (default: 1800 = 30 minutes)
#MIYUCLOUD_WOPI_LOCK_TTL_SECS=1800

# -----------------------------------------------------------------------------
# MEMORY ALLOCATOR TUNING (IMPORTANT FOR RAM USAGE)
# -----------------------------------------------------------------------------
# Miyukini Cloud uses mimalloc as its global memory allocator for performance.
# By default, mimalloc RETAINS freed memory in internal free-lists instead of
# returning it to the operating system. This causes the process RSS to grow
# over time (e.g., after large file uploads or password hashing) and never
# shrink back — even though the application has already freed that memory.
#
# In containerized / memory-constrained environments (Docker, K8s, VPS with
# limited RAM), this is critical: without these settings, the container can
# appear to "leak" hundreds of MiB that are actually just retained by the
# allocator.
#
# These variables are read directly by the mimalloc C library at startup.
# They are NOT Miyukini Cloud-specific — they are part of mimalloc's official API.
# Docs: https://microsoft.github.io/mimalloc/environment.html

# MIMALLOC_PURGE_DELAY: Delay (in ms) before freed memory is returned to the OS.
#   0  = return immediately (RECOMMENDED for Docker / limited RAM)
#   -1 = never return (maximum performance, highest RAM usage)
#   10 = mimalloc default (slight delay for reuse optimization)
# Setting this to 0 can reduce idle RAM by 80-120 MiB in typical deployments.
MIMALLOC_PURGE_DELAY=0

# MIMALLOC_ALLOW_LARGE_OS_PAGES: Use 2 MiB huge pages for allocations.
#   0 = disabled (RECOMMENDED for Docker — avoids RSS inflation from THP)
#   1 = enabled (better TLB performance on bare-metal servers with plenty of RAM)
# When enabled with Linux Transparent Huge Pages (THP), partially-used 2 MiB
# pages inflate the reported RSS by up to 20-30 MiB.
MIMALLOC_ALLOW_LARGE_OS_PAGES=0

# ── Security (lot 0 bis) ─────────────────────────────────────────
# Public self-registration is CLOSED by default (M-08). Open it explicitly
# here or from the admin panel (setting `registration_enabled`).
# MIYUCLOUD_DISABLE_REGISTRATION=true always wins.
# MIYUCLOUD_ENABLE_REGISTRATION=false

# Rate limiting keys on the TCP peer IP (M-06). Forwarding headers
# (X-Forwarded-For / X-Real-Ip) are honoured only when the peer is a trusted
# proxy: comma-separated IPs or CIDRs. MIYUCLOUD_TRUST_PROXY_HEADERS=true
# alone trusts the local proxy only (127.0.0.1, ::1).
# MIYUCLOUD_TRUSTED_PROXIES=127.0.0.1,::1

# Maximum size of a single upload in bytes (streamed to disk, quota checked
# while writing — M-04). Default: 10 GiB on 64-bit targets.
# MIYUCLOUD_MAX_UPLOAD_SIZE=10737418240

# ── Encryption at rest (blobs) ───────────────────────────────────
# AES-256-GCM, format MIYUCENC v1 (see doc/deduplication.md). The key is the
# standard base64 of EXACTLY 32 bytes, otherwise the server refuses to start.
# Any value other than false/0/no/off enables encryption. Legacy plaintext
# blobs stay readable. Losing the key makes encrypted blobs unreadable.
# MIYUCLOUD_ENCRYPTION_ENABLED=true
# MIYUCLOUD_ENCRYPTION_KEY=$(openssl rand -base64 32)

# Hourly reconciliation of blob reference counts + garbage collection
# (0 disables it).
# MIYUCLOUD_RECONCILIATION_REFERENCES=1
