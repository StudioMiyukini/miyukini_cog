# AppArmor — MAIA (orchestrateur d'agents, 127.0.0.1:11435). Installé par deploy/cog-vm/installer.sh.
# Données : /var/lib/miyukini/maia (0700). bridge.toml y est présenté en lecture seule (BindReadOnlyPaths).
# Réseau : TCP (écoute loopback, connexion à KindMother en loopback). Pas de processus fils :
# l'attente de KindMother est une unité distincte (miyukini-attente-kindmother), sans profil.
#include <tunables/global>

profile miyukini-maia /opt/miyukini/bin/maia flags=(enforce) {
  #include <abstractions/base>

  network inet stream,

  /opt/miyukini/bin/maia mr,
  @{PROC}/@{pid}/cgroup r,
  /sys/fs/cgroup/**/cpu.max r,
  # Sondes matérielles en lecture seule (profil de modèle, mémoire disponible).
  @{PROC}/ r,
  @{PROC}/uptime r,
  /sys/class/drm/ r,
  /sys/class/drm/** r,

  # Politiques StrongFather (COG_POLITIQUES_DIR), lecture seule.
  /etc/miyukini/strongfather/ r,
  /etc/miyukini/strongfather/** r,

  # Données : répertoire propre ; bridge.toml est une copie en lecture seule (écriture refusée).
  /var/lib/miyukini/maia/ r,
  /var/lib/miyukini/maia/** rwk,
  deny /var/lib/miyukini/maia/bridge.toml w,

  deny /var/lib/miyukini/kindmother/** rw,
  deny /var/lib/miyukini/miyucloud/** rw,
  deny /var/lib/miyukini/cog-web-portal/** rw,
  deny /etc/miyukini/** w,
  deny /etc/** w,
  deny /opt/miyukini/** w,
}
