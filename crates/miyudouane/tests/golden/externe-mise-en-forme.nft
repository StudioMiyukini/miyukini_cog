#!/usr/sbin/nft -f
# Généré par miyudouane — ne pas modifier à la main.
# Douane — règles de frontière (refus par défaut)
# frontiere=externe arrete=1 empreinte=<sha256>
# validite=1800000000..1802592000 emetteur=borderguard
# journal : nflog groupe 101, prefixe "MDOU|externe|<chaine>|<MOTIF>|"
# debit : filet x5/4 par sens (mise en forme tc appliquee)
flush ruleset

table inet miyudouane {
	set journal_v4 {
		type ipv4_addr . ipv4_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	set journal_v6 {
		type ipv6_addr . ipv6_addr . inet_proto
		size 65536
		flags dynamic,timeout
		timeout 10s
	}
	limit journal {
		rate 50/second burst 100 packets
	}
	counter rejets {
	}
	chain entree {
		type filter hook input priority filter; policy drop;
		iif "lo" accept
		ct state invalid update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|INVALIDE|" group 101
		ct state invalid update @journal_v6 { ip6 saddr . ip6 daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|INVALIDE|" group 101
		ct state invalid counter name "rejets" drop
		ct mark 0x00000001 meta length > 1400 update @journal_v4 { ip saddr . ip daddr . meta l4proto limit rate 1/second } limit name "journal" log prefix "MDOU|externe|entree|TAILLE|" group 101
